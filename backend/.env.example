# Slide Roast - Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/slide-roast
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/slide-roast?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/slide-roast

# Google Gemini API Key (Get yours free at https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Client Origin for CORS
CLIENT_URL=http://localhost:5173
